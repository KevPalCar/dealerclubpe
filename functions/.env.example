# ============================================================
# Plantilla de variables de entorno — bot de WhatsApp DealerClub
# ------------------------------------------------------------
# Copia este archivo como `.env` (para el emulador local) y
# rellena los valores. El `.env` real está en .gitignore y
# NUNCA se sube a Git.
#
# En PRODUCCIÓN, los valores sensibles se guardan como secretos
# de Firebase, no en .env:
#   firebase functions:secrets:set META_VERIFY_TOKEN
#   firebase functions:secrets:set META_APP_SECRET
#   firebase functions:secrets:set WHATSAPP_TOKEN
#   firebase functions:secrets:set LLM_API_KEY
# ============================================================

# --- Meta / WhatsApp ---------------------------------------
# Token que TÚ inventas (cualquier texto secreto). Lo pegas
# también en Meta al registrar el webhook. Sirve para que Meta
# demuestre que el webhook es tuyo.
META_VERIFY_TOKEN=pon-aqui-un-texto-secreto-que-tu-inventes

# "Clave secreta de la app" de Meta (App > Configuración > Básica).
# Se usa para validar la firma X-Hub-Signature-256.
META_APP_SECRET=

# Token de acceso de WhatsApp (temporal de 24h para pruebas, o
# permanente de Usuario del sistema para producción).
WHATSAPP_TOKEN=

# ID del número de teléfono de WhatsApp (de prueba por ahora).
WHATSAPP_PHONE_NUMBER_ID=1206665152525586

# --- Cerebro / LLM -----------------------------------------
# Proveedor del modelo: "gemini" o "claude".
LLM_PROVIDER=gemini

# Modelo concreto (opcional; hay valores por defecto en el código).
#   gemini -> gemini-2.5-flash-lite (free tier más amplio) | gemini-2.5-flash (mejor calidad, free tier 20/día)
#   claude -> claude-haiku-4-5-20251001
LLM_MODEL=

# Clave de API del proveedor elegido (Google AI Studio o Anthropic).
LLM_API_KEY=
